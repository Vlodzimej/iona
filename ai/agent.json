{
  "schemaVersion": 2,
  "maximumIterations": 16,
  "maximumToolCalls": 40,
  "maximumToolOutputBytes": 24000,
  "maximumReadBytes": 50000,
  "maximumPatchBytes": 200000,
  "maximumChangedFiles": 40,
  "checkTimeoutMs": 600000,
  "searchTimeoutMs": 10000,
  "executor": {
    "default": "docker",
    "docker": {
      "image": "ionic-llm-agent-runner:node-26",
      "workspace": "/workspace",
      "network": "none",
      "cpus": 2,
      "memory": "4g",
      "pidsLimit": 256,
      "temporaryStorage": "512m"
    }
  },
  "approvals": {
    "ttlMs": 3600000
  },
  "api": {
    "hostname": "127.0.0.1",
    "port": 7331,
    "maximumBodyBytes": 100000,
    "maximumConcurrentRuns": 1,
    "tokenEnvironmentVariable": "LOCAL_AGENT_API_TOKEN"
  },
  "allowedWritePatterns": ["src/**", "public/**", "tests/**", "e2e/**"],
  "protectedWritePatterns": [
    "package.json",
    "package-lock.json",
    "angular.json",
    "ionic.config.json",
    "capacitor.config.*",
    "tsconfig*.json",
    "vitest.config.*",
    "AGENTS.md",
    "README.md",
    "ai/**",
    "scripts/**",
    ".github/**",
    "android/**",
    "ios/**"
  ],
  "deniedPatterns": [
    ".git",
    ".git/**",
    ".agent",
    ".agent/**",
    ".agent-tmp",
    ".agent-tmp/**",
    ".env",
    ".env*",
    ".env.*",
    "**/.env",
    "**/.env*",
    "**/.env.*",
    ".npmrc",
    "**/.npmrc",
    ".netrc",
    "**/.netrc",
    ".docker",
    ".docker/**",
    "**/.docker/**",
    "node_modules",
    "node_modules/**",
    "dist",
    "dist/**",
    "coverage",
    "coverage/**",
    "**/*.pem",
    "**/*.key",
    "**/*.p12",
    "**/*.jks",
    "**/*.keystore",
    "**/*.mobileprovision",
    "**/google-services.json",
    "**/GoogleService-Info.plist"
  ],
  "checks": {
    "fast": [
      ["npm", "run", "format:check"],
      ["npm", "test", "--", "--watch=false"]
    ],
    "build": [
      ["npm", "run", "format:check"],
      ["npm", "run", "build"]
    ],
    "full": [
      ["npm", "run", "format:check"],
      ["npm", "run", "build"],
      ["npm", "test", "--", "--watch=false"],
      ["npm", "run", "cap:check"],
      ["npm", "run", "ai:doctor"],
      ["npm", "run", "agent:test"]
    ]
  },
  "requiredFinishCheck": "full"
}
