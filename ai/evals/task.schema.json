{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-ai.invalid/schemas/angular-capacitor-task.schema.json",
  "title": "Angular and Capacitor local-model task",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "category", "prompt", "readOnly", "expectedSkills", "checks"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
    "title": { "type": "string", "minLength": 3 },
    "category": {
      "enum": ["angular", "ionic", "capacitor", "hybrid-architecture", "testing", "security"]
    },
    "prompt": { "type": "string", "minLength": 10 },
    "readOnly": { "type": "boolean" },
    "expectedSkills": {
      "type": "array",
      "items": { "enum": ["angular-developer", "capacitor-plugins"] },
      "minItems": 1,
      "uniqueItems": true
    },
    "expectedReferences": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "values"],
        "properties": {
          "type": { "enum": ["contains", "contains-any", "not-contains", "not-matches"] },
          "values": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          }
        }
      }
    },
    "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 }
  }
}
