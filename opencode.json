{
  "$schema": "https://opencode.ai/config.json",
  "model": "lmstudio/gpt-oss-20b",
  "small_model": "lmstudio/gpt-oss-20b",
  "enabled_providers": ["lmstudio"],
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Remote LM Studio",
      "options": {
        "baseURL": "{env:LOCAL_AI_BASE_URL}",
        "apiKey": "{env:LOCAL_AI_API_KEY}"
      },
      "models": {
        "gpt-oss-20b": {
          "name": "gpt-oss-20b",
          "limit": {
            "context": 32768,
            "output": 4096
          },
          "options": {
            "reasoningEffort": "low",
            "temperature": 0.1
          }
        }
      }
    }
  },
  "instructions": ["AGENTS.md", "ai/prompts/system.md"],
  "permission": {
    "edit": "ask",
    "bash": "ask"
  },
  "watcher": {
    "ignore": [
      ".agent/**",
      ".angular/**",
      "ai/generated/**",
      "coverage/**",
      "dist/**",
      "node_modules/**"
    ]
  }
}
