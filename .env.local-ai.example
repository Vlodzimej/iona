# OpenAI-compatible endpoint. Keep the real file in .env.local-ai; it is ignored by Git.
LOCAL_AI_BASE_URL=http://127.0.0.1:1234/v1
LOCAL_AI_MODEL=gpt-oss-20b
LOCAL_AI_API_KEY=

# Client and generation limits.
LOCAL_AI_TIMEOUT_MS=120000
LOCAL_AI_MAX_TOKENS=4096
LOCAL_AI_TEMPERATURE=0.1
LOCAL_AI_REASONING_EFFORT=low

# Skill retrieval limits. Project code is excluded unless --with-project-reference is passed.
LOCAL_AI_SKILL_MAX_BYTES=7200
LOCAL_AI_PROJECT_MAX_FILES=8
LOCAL_AI_PROJECT_MAX_BYTES=100000

# Keep disabled unless the entire runtime already runs in an isolated container.
LOCAL_AGENT_ALLOW_HOST_EXECUTION=0
LOCAL_AGENT_EXECUTOR=docker

# Optional Agent API. Generate a unique token with at least 32 random characters.
LOCAL_AGENT_API_TOKEN=
LOCAL_AGENT_API_HOST=127.0.0.1
LOCAL_AGENT_API_PORT=7331
LOCAL_AGENT_API_ALLOW_REMOTE=0
