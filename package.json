{
  "name": "ionic-llm-boilerplate",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "cap:sync": "npm run build && cap sync",
    "cap:doctor": "cap doctor",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "verify": "npm run format:check && npm run build && npm test -- --watch=false && npm run cap:doctor && npm run ai:doctor && npm run agent:doctor -- --source-only && npm run agent:test",
    "ai:doctor": "node scripts/local-ai/doctor.mjs",
    "ai:context": "node scripts/local-ai/build-context.mjs",
    "ai:smoke": "node scripts/local-ai/model-smoke.mjs",
    "ai:ask": "node scripts/local-ai/ask.mjs",
    "agent": "node scripts/agent/run.mjs",
    "agent:doctor": "node scripts/agent/doctor.mjs",
    "agent:test": "node --test scripts/agent/tests/*.test.mjs"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.0",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/status-bar": "8.0.3",
    "@ionic/angular": "8.8.17",
    "ionicons": "8.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.0",
    "@capacitor/android": "8.5.0",
    "@capacitor/cli": "8.5.0",
    "@capacitor/ios": "8.5.0",
    "@ionic/angular-toolkit": "12.3.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
